{
  "name": "hubctl",
  "version": "0.4.0",
  "description": "Agent-first GitHub administration CLI (Bun + TypeScript + Effect)",
  "type": "module",
  "bin": {
    "hubctl": "bin/hubctl"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "repl": "bun repl --preload ./scripts/repl.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --config oxlint.config.mjs --report-unused-disable-directives-severity=error src test scripts",
    "lint:fix": "oxlint --config oxlint.config.mjs --report-unused-disable-directives-severity=error --fix src test scripts",
    "format": "oxfmt --config oxfmt.config.mjs --check src test scripts",
    "format:fix": "oxfmt --config oxfmt.config.mjs src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "ast-grep": "ast-grep scan",
    "ast-grep:test": "ast-grep test",
    "fallow": "fallow audit --quiet",
    "build:local": "bun run scripts/compile.ts",
    "validate": "bun run format && bun run lint && bun run typecheck && bun run test && bun run ast-grep",
    "postinstall": "effect-language-service patch && effect-tsgo patch",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx nano-staged",
    "pre-push": "bun run validate",
    "commit-msg": "bunx commitlint --edit"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-beta.86",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/types": "^16.0.0",
    "effect": "^4.0.0-beta.86"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@effect/language-service": "^0.86.2",
    "@effect/tsgo": "^0.14.6",
    "@effect/vitest": "^4.0.0-beta.86",
    "@mpsuesser/oxlint-plugin-effect": "^0.3.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260622.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.3",
    "vitest": "^4.1.9"
  }
}
