#!/usr/bin/env bun
// hubctl launcher. Prefers the Bun-compiled standalone binary (built by
// `scripts/compile.ts` → `dist/hubctl`, Task 4.4) when it exists; otherwise
// runs the TypeScript entrypoint directly via Bun for local development.
//
// The compiled binary embeds its own runtime and argv handling, so we hand it
// the user's argv unchanged. In the dev fallback we re-exec `src/main.ts`,
// which slices `process.argv` itself.
import { spawnSync } from 'node:child_process'
import { existsSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const here = dirname(fileURLToPath(import.meta.url))
const root = join(here, '..')
const compiled = join(root, 'dist', 'hubctl')
const args = process.argv.slice(2)

const target = existsSync(compiled)
  ? { cmd: compiled, argv: args }
  : { cmd: 'bun', argv: [join(root, 'src', 'main.ts'), ...args] }

const result = spawnSync(target.cmd, target.argv, { stdio: 'inherit' })
process.exit(result.status ?? 1)
